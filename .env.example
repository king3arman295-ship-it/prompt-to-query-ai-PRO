# Copy this file to .env and fill in your real key.
# .env is loaded by backend/main.py and is NEVER sent to the browser/frontend.
# Do not commit your real .env file to git.

# "openai" (any OpenAI-compatible endpoint incl. Groq/DeepSeek/Gemini), "xai", or "ollama"
LLM_PROVIDER=openai

# Base URL for the chosen provider
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model name for the chosen provider
LLM_MODEL=openai/gpt-oss-20b

# Your secret API key. Leave blank only for provider=ollama (local, no key needed).
LLM_API_KEY=your-api-key-here
